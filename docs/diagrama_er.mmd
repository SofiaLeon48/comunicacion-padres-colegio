erDiagram
    roles ||--o{ usuarios : "tiene"
    roles ||--o{ rol_modulo : "puede ver"
    modulos ||--o{ rol_modulo : "asignado a"
    usuarios |o--o{ cursos : "dirige"
    cursos ||--o{ estudiantes : "matricula"
    usuarios ||--o{ acudiente_estudiante : "es acudiente"
    estudiantes ||--o{ acudiente_estudiante : "tiene acudiente"
    cursos |o--o{ comunicados : "dirigido a"
    usuarios ||--o{ comunicados : "publica"
    comunicados ||--o{ confirmaciones_lectura : "recibe"
    usuarios ||--o{ confirmaciones_lectura : "confirma"
    usuarios ||--o{ mensajes : "envía"
    cursos |o--o{ mensajes : "chat del curso"
    usuarios |o--o{ mensajes : "recibe directo"
    usuarios ||--o{ notificaciones : "recibe"
    estudiantes ||--o{ citaciones : "sobre"
    usuarios ||--o{ citaciones : "agenda (docente)"
    usuarios |o--o{ citaciones : "citado (acudiente)"
    citaciones ||--o| asistencia_citaciones : "resultado 1:1"
    usuarios ||--o{ asistencia_citaciones : "registra"
    usuarios |o--o{ logs_actividad : "realiza"

    roles {
        serial id PK
        varchar nombre UK
        varchar descripcion
        timestamp creado
        timestamp modificado
        varchar estado
    }
    usuarios {
        serial id PK
        varchar nombre
        varchar correo UK
        varchar password_hash
        varchar telefono
        int rol_id FK
        timestamp ultimo_acceso
        timestamp creado
        timestamp modificado
        varchar estado
    }
    cursos {
        serial id PK
        varchar nombre
        smallint grado
        varchar jornada
        smallint anio_lectivo
        int director_id FK
        timestamp creado
        timestamp modificado
        varchar estado
    }
    estudiantes {
        serial id PK
        varchar nombre
        varchar documento UK
        int curso_id FK
        timestamp creado
        timestamp modificado
        varchar estado
    }
    acudiente_estudiante {
        serial id PK
        int acudiente_id FK
        int estudiante_id FK
        varchar parentesco
        boolean es_principal
        timestamp creado
        timestamp modificado
        varchar estado
    }
    comunicados {
        serial id PK
        varchar titulo
        text contenido
        int curso_id FK "NULL = general"
        int autor_id FK
        varchar prioridad
        boolean requiere_confirmacion
        timestamp fecha_publicacion
        timestamp creado
        timestamp modificado
        varchar estado
    }
    confirmaciones_lectura {
        serial id PK
        int comunicado_id FK
        int usuario_id FK
        timestamp fecha_confirmacion
        timestamp creado
        timestamp modificado
        varchar estado
    }
    mensajes {
        serial id PK
        int remitente_id FK
        int curso_id FK "chat (o)"
        int destinatario_id FK "directo (o)"
        text contenido
        boolean leido
        timestamp fecha_envio
        timestamp creado
        timestamp modificado
        varchar estado
    }
    notificaciones {
        serial id PK
        int usuario_id FK
        varchar tipo
        varchar titulo
        varchar contenido
        int referencia_id
        boolean leido
        boolean enviado_correo
        timestamp fecha
        timestamp creado
        timestamp modificado
        varchar estado
    }
    citaciones {
        serial id PK
        int estudiante_id FK
        int docente_id FK
        int acudiente_id FK "NULL = todos"
        varchar motivo
        timestamp fecha_hora
        varchar lugar
        varchar estado_citacion
        timestamp creado
        timestamp modificado
        varchar estado
    }
    asistencia_citaciones {
        serial id PK
        int citacion_id FK,UK
        boolean asistio
        text observaciones
        int registrado_por FK
        timestamp creado
        timestamp modificado
        varchar estado
    }
    logs_actividad {
        serial id PK
        int usuario_id FK
        varchar accion
        varchar entidad
        int entidad_id
        varchar detalle
        timestamp fecha
        timestamp creado
        timestamp modificado
        varchar estado
    }
    modulos {
        serial id PK
        varchar clave UK
        varchar nombre
        varchar descripcion
        varchar ruta
        varchar icono
        smallint orden
        timestamp creado
        timestamp modificado
        varchar estado
    }
    rol_modulo {
        serial id PK
        int rol_id FK
        int modulo_id FK
        timestamp creado
        timestamp modificado
        varchar estado
    }
