# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube a GitHub.

# Neon → tu proyecto → Connect → copia la "Connection string"
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pon-aqui-una-clave-larga-y-secreta
JWT_EXPIRA_MINUTOS=480

ZONA_HORARIA=America/Bogota

# Dirección del frontend Svelte (Vite usa el puerto 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo con Brevo (recomendado; funciona en Render gratis). https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Conecta Escolar

# Inteligencia artificial (Google Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Llave del enlace público del tablero (opcional; si se deja vacía se deriva de JWT_SECRET)
TABLERO_TOKEN=

# App móvil (Capacitor) y Vercel
CORS_ORIGIN_REGEX=(https://.*\.vercel\.app|https?://localhost|capacitor://localhost)

# Correo por SMTP (alternativa a Brevo). Déjalo vacío para no usarlo.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=
