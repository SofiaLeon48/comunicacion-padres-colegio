# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube a GitHub.

# Neon → tu proyecto → Connect → copia la "Connection string"
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pon-aqui-una-clave-larga-y-secreta
JWT_EXPIRA_MINUTOS=480

ZONA_HORARIA=America/Bogota

# Dirección del frontend Svelte (Vite usa el puerto 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo (opcional). Déjalo vacío para no enviar correos.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=
